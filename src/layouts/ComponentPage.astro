---
import { readFileSync } from 'node:fs';
import { Code } from 'astro:components';
import { demoUrl, type Framework } from '../lib/demo-urls';
import type { ComponentPropsDoc, NamedPropSection, PropDoc } from '../../scripts/extract-props/types';

interface Props {
  slug: string;
  title: string;
  description: string;
  demoSourcePaths: Record<Framework, string>;
}
const { slug, title, description, demoSourcePaths } = Astro.props;
// A plain `readFileSync(new URL(..., import.meta.url))` resolves relative to
// wherever Astro's build bundles this component's compiled module inside
// `dist/`, not to its source location — works in `astro dev` (which serves
// source files directly) but breaks in `astro build` (confirmed: it looked
// for `dist/pages/data/props/<slug>.json`). `import.meta.glob` is resolved
// statically by Vite at build time, so the JSON is inlined into the bundle
// regardless of where the output file ends up.
const propsModules = import.meta.glob<ComponentPropsDoc>('../data/props/*.json', { eager: true, import: 'default' });
const propsDoc = propsModules[`../data/props/${slug}.json`];
const frameworks: Framework[] = ['react', 'vue', 'svelte', 'angular'];
const noteKeys = { react: 'reactNote', vue: 'vueNote', svelte: 'svelteNote', angular: 'angularNote' } as const;

// Demo source files import from their own repo's real relative paths
// (`../src/components/button`) so the demo app actually builds and runs —
// but that's not what a reader should copy-paste, since `@manthan/*` isn't
// published under those paths (or at all, yet). Rewritten for DISPLAY only;
// the file on disk (and the running demo) is untouched. Angular's demos
// already import `@manthan/angular` directly, so this is a no-op there.
function forDisplay(code: string, fw: Framework): string {
  return code.replace(/from '\.\.\/src\/[^']*'/g, `from '@manthan/${fw}'`);
}

function isFamilyPage(value: PropDoc[] | NamedPropSection[] | undefined): value is NamedPropSection[] {
  return Array.isArray(value) && value.length > 0 && 'component' in value[0];
}
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} — Manthan Docs</title>
  </head>
  <body>
    <h1>{title}</h1>
    <p>{description}</p>
    <slot />
    {frameworks.map((fw) => (
      <section>
        <h2>{fw}</h2>
        <iframe src={demoUrl(fw, slug)} title={`${title} — ${fw} demo`} style="width:100%;height:200px;border:1px solid #ccc;" />
        <Code code={forDisplay(readFileSync(demoSourcePaths[fw], 'utf-8'), fw)} lang={fw === 'vue' ? 'vue' : fw === 'svelte' ? 'svelte' : 'tsx'} />
        {propsDoc[fw] && isFamilyPage(propsDoc[fw]) ? (
          (propsDoc[fw] as NamedPropSection[]).map((section) => (
            <>
              <h3>{section.component}</h3>
              <table>
                <thead><tr><th>Name</th><th>Type</th><th>Required</th><th>Default</th><th>Description</th></tr></thead>
                <tbody>
                  {section.members.map((p) => (
                    <tr><td>{p.name}</td><td><code>{p.type}</code></td><td>{p.required ? 'Yes' : 'No'}</td><td>{p.default ?? '—'}</td><td>{p.description ?? ''}</td></tr>
                  ))}
                </tbody>
              </table>
              {section.note && <p><em>{section.note}</em></p>}
            </>
          ))
        ) : propsDoc[fw] && (
          <table>
            <thead><tr><th>Name</th><th>Type</th><th>Required</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
              {(propsDoc[fw] as PropDoc[]).map((p) => (
                <tr><td>{p.name}</td><td><code>{p.type}</code></td><td>{p.required ? 'Yes' : 'No'}</td><td>{p.default ?? '—'}</td><td>{p.description ?? ''}</td></tr>
              ))}
            </tbody>
          </table>
        )}
        {propsDoc[noteKeys[fw]] && <p><em>{propsDoc[noteKeys[fw]]}</em></p>}
      </section>
    ))}
  </body>
</html>
